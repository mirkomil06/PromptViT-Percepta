# =========================================================
# PromptViT-Percepta — Project .gitignore
# =========================================================

# -----------------------
# 1. Python
# -----------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.egg-info/
*.so

# Virtual environments
.env/
.venv/
venv/
ENV/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/

# -----------------------
# 2. Datasets (your actual data structure)
# -----------------------
data/
data/cub200/
data/cars/
data/flowers/

# Prevent accidental giant uploads anywhere
**/data/
**/datasets_raw/
**/images_raw/

# Allow dataset loader code
!src/datasets/

# -----------------------
# 3. Model checkpoints / weights
# -----------------------
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# HuggingFace cache
huggingface/
~/.cache/huggingface/

# -----------------------
# 4. Archives (exports, downloads)
# -----------------------
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Kaggle / Colab dumps
*.h5
*.pkl
*.npz

# -----------------------
# 5. Training logs / experiments
# -----------------------
runs/
logs/
wandb/
lightning_logs/
mlruns/

# TensorBoard
tb_logs/
events.*

# -----------------------
# 6. IDE & Editor junk
# -----------------------
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# -----------------------
# 7. Temporary files
# -----------------------
*.tmp
*.temp
*.bak
*.old

# -----------------------
# 8. PDFs not created by repo
# -----------------------
*.pdf
!CV25_Proposal_Percepta.pdf       # keep your project proposal

