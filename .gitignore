# =========================================================
# PromptViT-Percepta — Project .gitignore
# Clean version with support for pushing logs/ metadata
# =========================================================


##############################
# 1. Python
##############################
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.so

# Virtual environments
.env/
.venv/
.venv311/
venv/
ENV/
env/

# Jupyter
.ipynb_checkpoints/


##############################
# 2. Datasets (local only)
##############################
data/
**/data/
**/datasets_raw/
**/images_raw/

# Allow dataset loader code
!src/datasets/


##############################
# 3. Model checkpoints / weights
##############################
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# HuggingFace cache
huggingface/
.cache/huggingface/


##############################
# 4. Archives & exports
##############################
*.zip
*.tar
*.tar.gz
*.gz
*.rar
*.7z
*.h5
*.pkl
*.npz


##############################
# 5. Training logs / TensorBoard
##############################

# Ignore all heavy event logs
**/logs/*.tfevents.*

# Allow README.md and .gitignore inside logs/
!**/logs/
!**/logs/.gitignore
!**/logs/README.md

# Ignore other experiment directories
runs/
wandb/
lightning_logs/
mlruns/
tb_logs/


##############################
# 6. IDE & Editor files
##############################
.vscode/
.idea/
*.code-workspace

# OS-generated
.DS_Store
Thumbs.db


##############################
# 7. Temporary files
##############################
*.tmp
*.temp
*.bak
*.old


##############################
# 8. PDFs
##############################
*.pdf

# Allow only your official proposal
!CV25_Proposal_Percepta.pdf
